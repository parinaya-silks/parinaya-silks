# Browser-visible Firebase web app configuration. No server secrets belong here.
# Copy to .env.local and replace placeholders with the supplied web configuration.
VITE_FIREBASE_API_KEY=your_firebase_browser_api_key
VITE_FIREBASE_AUTH_DOMAIN=parinaya-silks.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=parinaya-silks
VITE_FIREBASE_STORAGE_BUCKET=parinaya-silks.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id

# Owner-confirmed Cloud Firestore database. No emulator variables are used.
VITE_FIREBASE_DATABASE_ID=(default)

# Optional: leave empty until a safe, signed-out document read is approved by rules.
# This must identify one document, never a collection or database root.
VITE_FIREBASE_CHECK_DOCUMENT_PATH=

# Server-only placeholders. Put actual values in ignored .env.server.local for
# npm run dev:api, and Vercel server environment variables. NEVER use VITE_*.
# Use either an approved local credential path OR server JSON (not both).
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
